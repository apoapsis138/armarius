# Copy to .env beside compose.yaml and fill in. Nothing here is secret;
# the tunnel's token goes in tunnel.env.

# The image's version, as on the Releases page (4.13.0, say). Change it
# deliberately to move to a newer version.
ARMARIUS_VERSION=
# The id of the saga this box hosts (admin sagas lists them).
ARMARIUS_SAGA=

# Where the saga, the keys and the backups live on this computer.
# KEYS_DIR: a private folder of its own, outside DATA_DIR, owned
# 10001:10001, mode 700, no NAS access lists (setfacl -b); the app
# refuses one that is missing or others can open. Encrypted where the
# box can (a disk or volume, or a NAS encrypted shared folder the app's
# user can use; UGOS's can't): a plain folder doesn't protect the key
# from someone who steals the drives. Back it and tunnel.env up apart
# from the nightly backups. See docs/threat-model-headless-host.md.
DATA_DIR=./data
KEYS_DIR=./keys
BACKUPS_DIR=./backups

# The backup service: how often (seconds; 86400 is a day) and how many to
# keep.
BACKUP_EVERY=86400
BACKUPS_KEPT=30
