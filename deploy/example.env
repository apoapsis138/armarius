# Copy to .env beside compose.yaml and fill in. Nothing here is secret;
# the tunnel's token goes in tunnel.env.

# The image's version, as on the Releases page (4.13.0, say). Change it
# deliberately to move to a newer version.
ARMARIUS_VERSION=
# The id of the saga this box hosts (admin sagas lists them).
ARMARIUS_SAGA=

# Where the saga, the keys and the backups live on this computer. Keep
# KEYS_DIR in an encrypted shared folder, apart from DATA_DIR.
DATA_DIR=./data
KEYS_DIR=./keys
BACKUPS_DIR=./backups

# The backup service: how often (seconds; 86400 is a day) and how many to
# keep.
BACKUP_EVERY=86400
BACKUPS_KEPT=30
