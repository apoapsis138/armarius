# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.ruff_cache/
.pytest_cache/

# Per-saga save data -- not source, these are user campaign data
data/sagas/*.json
# Backups taken before a season is applied (storage.backup_saga)
data/sagas/backups/
!data/sagas/.gitkeep

# Exported covenants, laboratories and characters ('x' on a sheet) -- user
# campaign data, like the saves
data/exports/

# App-wide settings (e.g. selected theme) -- local machine state, not source
data/app_settings.json

# The maintainer's own assistant setup (instructions, hooks, skills, the
# test of the hook): local to their PC, not part of the public repo.
CLAUDE.md
.claude/
tests/test_prefer_tools_hook.py

# AI-session handoff notes -- internal project/dev notes, not meant for
# the public repo (same convention as Ars-Magica-Solo).
HANDOFF.md
# Rules notes and source PDFs live outside the repo; tools/build_spell_catalog.py
# and tools/build_shape_material_catalog.py still read their inputs from here.
reference/